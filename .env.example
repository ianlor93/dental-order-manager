# =============================================================================
#  Order Manager — esempio di configurazione
# =============================================================================
#  Copiare in .env e valorizzare. Dopo ogni modifica: php artisan config:cache
#
#  I segreti e i dati di identità sono volutamente VUOTI.
#  Le chiavi marcate NECESSARIA NELLA PRATICA hanno un default tecnico valido,
#  ma lasciarle vuote produce link vuoti nelle email, campi vuoti nei testi
#  legali e il rifiuto del form della landing.
# =============================================================================

# --- Applicazione ------------------------------------------------------------
APP_NAME="Order Manager"
APP_ENV=production
# generata con `php artisan key:generate`
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# forza lo schema https negli URL generati
FORCE_HTTPS=true

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sessione / Cache / Code -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# IMPOSTARLA IN MODO ESPLICITO: se resta vuota il nome del cookie viene derivato da APP_NAME
SESSION_COOKIE=order_manager_session
# lasciare vuoto per il solo host corrente; valorizzare (es. .example.org) per condividere il cookie tra sottodomini
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
# destinatario delle notifiche interne (DPO / PRRC): se vuoto non vengono inviate
MAIL_INTERNAL_RECIPIENT=

# --- Integrazione Nextcloud --------------------------------------------------
# NECESSARIA NELLA PRATICA: se resta vuota i pulsanti e i link delle email puntano al nulla
NEXTCLOUD_URL=https://nextcloud.example.org
# NECESSARIA: chiave pubblica ES256 dell'app Nextcloud "External Sites" (oc_appconfig external/jwt_token_pubkey_es256),
# come PEM codificata in base64 su una riga (es. base64 -w0 chiave.pem). Se resta vuota nessun utente può accedere.
NEXTCLOUD_SSO_PUBKEY_B64=
# chiave pubblica ES256 dedicata al provisioning degli utenti da Nextcloud, stesso formato. Se resta vuota il provisioning è disabilitato.
NC_PROVISIONING_PUBKEY_B64=
# segreto condiviso con l’app Nextcloud enamel_gate
GATE_SHARED_SECRET=

# --- Laboratorio (LAB_*) — fabbricante ai sensi del MDR 2017/745 -------------
# NECESSARIA NELLA PRATICA: se resta vuota i testi legali (contratto, DPA, informative) escono con il nome del fabbricante VUOTO
LAB_MANUFACTURER_NAME=
LAB_ADDRESS=
# chi vuole la provincia la scrive qui, es. "Roma (RM)"
LAB_CITY=
LAB_ZIP=
LAB_COUNTRY=IT
LAB_VAT=
LAB_PHONE=
# NECESSARIA NELLA PRATICA: è il contatto per la protezione dei dati citato nelle informative; se resta vuota il recapito nei testi legali è vuoto
LAB_EMAIL=
LAB_MDR_REGISTRATION=
LAB_REA=
LAB_PEC=
LAB_LEGAL_REP=
# foro competente, es. "Tribunale di Roma"
LAB_COURT=
# Persona Responsabile del rispetto della normativa (Art. 15 MDR)
LAB_PRRC_NAME=
LAB_PRRC_ROLE="Responsabile Conformità Regolamentare"
LAB_PRRC_EMAIL=
LAB_PRRC_PHONE=
# lasciare vuoto se il DPO non è nominato
LAB_DPO_NAME=
LAB_DPO_EMAIL=
LAB_DPO_PHONE=

# --- Sito vetrina (LANDING_*) ------------------------------------------------
# NECESSARIA NELLA PRATICA: se resta vuota i rimandi al sito pubblico sono vuoti
LANDING_URL=
# NECESSARIA NELLA PRATICA: elenco separato da virgole delle origini ammesse per il form di pre-registrazione, CON e SENZA www. Se resta vuota il form della landing viene RIFIUTATO. Es. https://example.org,https://www.example.org
LANDING_ORIGINS=

# --- Storage — percorsi dei dischi -------------------------------------------
FILESYSTEM_DISK=local
# ingresso ordini
UNRAID_STORAGE_PATH=/app/storage/unraid_ing_l
# banco di lavoro
BAC_L_STORAGE_PATH=/app/storage/unraid_bac_l
# finitura e spedizione
FIN_L_STORAGE_PATH=/app/storage/unraid_fin_l
# archivio storico MDR
ARCH_L_STORAGE_PATH=/app/storage/unraid_arch_l

# --- Log ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --- Conformità e antivirus --------------------------------------------------
# versione dei testi legali presentati all’onboarding
# deve coincidere con la versione dichiarata nei testi legali (oggi 2026.4)
LEGAL_VERSION=2026.4
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
